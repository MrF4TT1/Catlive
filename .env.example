# Copia questo file in ".env" per lo sviluppo locale, o imposta queste variabili
# nella dashboard di Render per la produzione.

# Porta del server (in locale). Su Render viene impostata automaticamente.
PORT=4000

# Segreto per firmare i token di sessione (OBBLIGATORIO in produzione).
JWT_SECRET=cambia-questo-segreto-con-una-stringa-lunga-e-casuale

# --- Account amministratore unico (così accedi solo tu) ---
# Se impostati e non esiste ancora nessun utente, l'admin viene creato all'avvio.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Database persistente (Neon / Postgres). Se vuoto → file locale data/db.json ---
# Esempio Neon: postgres://utente:password@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# --- Archiviazione video (Cloudflare R2). Se vuoti → disco locale data/uploads ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Opzioni ---
# Dimensione massima per file caricato (MB). Default 500.
MAX_UPLOAD_MB=500
# Consenti la scansione di cartelle locali del server (SOLO self-host: in cloud è una
# lettura di file arbitrari). Default disattivato.
ALLOW_LOCAL_SCAN=false
# Solo se Neon dà errori di certificato SSL (sconsigliato): disattiva la verifica.
PG_SSL_NO_VERIFY=false
